{
  "name": "dsh-session-delete",
  "version": "1.0.0",
  "private": true,
  "description": "Adds a confirmed \"Delete session\" action to the sidebar session menu: warns about linked sessions, requires the word delete, and can also remove the project files the session created.",
  "repository": {
    "type": "git",
    "url": "https://github.com/mikhailnarzik-source/dsh-session-delete.git"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "session",
    "delete"
  ],
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-workspace"
      ]
    }
  }
}
